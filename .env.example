# --- Database ---
POSTGRES_USER=football
POSTGRES_PASSWORD=football
POSTGRES_DB=football
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://football:football@localhost:5433/football

# --- API-Football (https://www.api-football.com) ---
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_KEY=
API_FOOTBALL_DAILY_LIMIT=100
API_FOOTBALL_TIMEOUT_SECONDS=10
API_FOOTBALL_MAX_ATTEMPTS=3

# --- Uygulama ---
ENVIRONMENT=local
LOG_LEVEL=INFO
DEFAULT_LEAGUE_ID=203
DEFAULT_SEASON=2024
# Zamanlanmış sync'in takip ettiği ligler (API id). Kuralları: backend/app/rules/specs/leagues
# 203 Süper Lig, 39 Premier League, 140 La Liga, 78 Bundesliga, 135 Serie A
TRACKED_LEAGUES=[203,39,140,78,135]
CORS_ORIGINS=["http://localhost:3000"]
SCHEDULER_ENABLED=false
SYNC_CRON="0 4 * * *"
SYNC_API_TOKEN=
SYNC_STALE_AFTER_MINUTES=30
# Maç istatistikleri isteğe bağlı çekilir; günlük kotanın son N isteği sync'e ayrılır
STATISTICS_QUOTA_RESERVE=10

# --- AI karşılaştırma (Bonus C) ---
# Sağlayıcılar sırayla denenir: Gemini → OpenRouter (yedek). İkisi de boşsa özellik kapalı.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
AI_DAILY_LIMIT=50
